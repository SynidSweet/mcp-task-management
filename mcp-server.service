[Unit]
Description=Centralized MCP HTTP Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/.claude/task-sprint-system/mcp-server
ExecStart=/home/ubuntu/.claude/task-sprint-system/mcp-server/venv/bin/python http_wrapper.py --port 8081
Restart=always
RestartSec=10
Environment=PATH=/home/ubuntu/.claude/task-sprint-system/mcp-server/venv/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target